  "author": "Gerald Soto-Carrion <gerald.starks@icloud.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/starkslabs/epic-fab"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
