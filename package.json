{
  "name": "epic-fab",
  "version": "0.1.1",
  "description": "Linux-native CLI for browsing and downloading your Epic Games / Fab.com asset library. Works without the Epic Games Launcher.",
  "type": "module",
  "bin": {
    "epic-fab": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "epic-games",
    "fab",
    "unreal-engine",
    "linux",
    "cli",
    "marketplace",
    "quixel",
    "megascans"
  ],
